<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ImmichUploader</AssemblyName>
    <RootNamespace>ImmichUploader</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>Immich Uploader</AssemblyTitle>
    <Product>Immich Uploader</Product>
    <Version>1.1.1</Version>
    <Company></Company>
    <!--
      Publish-only settings (self-contained single file, compression, RID) are
      supplied on the publish command line so that a plain `dotnet build` and the
      test project reference a RID-less, framework-dependent assembly. See
      README.md "Build the tray app" for the full publish command.
    -->
  </PropertyGroup>

  <!-- The test project lives in a subfolder; keep it out of the app compile. -->
  <ItemGroup>
    <Compile Remove="ImmichUploader.Tests\**" />
    <None Remove="ImmichUploader.Tests\**" />
    <EmbeddedResource Remove="ImmichUploader.Tests\**" />
  </ItemGroup>

  <!--
    The same artwork drives the Win32 exe icon (ApplicationIcon, above) and the
    runtime window/tray icons. Embedded so single-file publishes and `dotnet run`
    behave identically and no loose asset files need shipping.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="ImmichUploader.Assets.app.ico" />
    <EmbeddedResource Include="Assets\app-small.png" LogicalName="ImmichUploader.Assets.app-small.png" />
  </ItemGroup>
</Project>
